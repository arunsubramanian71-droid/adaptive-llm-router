# Copy to .env and fill in. Never commit the real .env file.
# None of these are required just to import/load the project or run the
# test suite -- only to make a real (--live) call to that provider.

# Required to make any real Anthropic API call.
ANTHROPIC_API_KEY=

# Optional: override the Anthropic base URL (proxies, testing).
# ANTHROPIC_BASE_URL=

# Required to make any real OpenAI API call.
OPENAI_API_KEY=

# Optional: override the OpenAI base URL (proxies, testing).
# OPENAI_BASE_URL=

# Required to make any real Google Gemini API call. Set EITHER one -- both
# are accepted per current Google documentation; if both are set,
# GOOGLE_API_KEY takes precedence (google-genai SDK behavior).
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Optional: log level for the router's structured logger.
ROUTER_LOG_LEVEL=INFO
